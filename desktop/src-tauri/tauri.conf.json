{
  "$schema":    "../node_modules/@tauri-apps/cli/schema.json",
  "build":      { "beforeBuildCommand": "npm run build", "beforeDevCommand": "npm run dev",
                  "devPath": "http://localhost:1420", "distDir": "../dist" },
  "package":    { "productName": "OpenCam Desktop", "version": "0.1.0" },
  "tauri": {
    "allowlist":  { "all": false, "shell": { "all": false, "open": true } },
    "bundle":     { "active": true, "identifier": "com.opencam.desktop",
                    "icon": ["icons/32x32.png", "icons/128x128.png"],
                    "targets": "all" },
    "security":   { "csp": "default-src 'self'; media-src blob: mediastream: 'self'" },
    "updater":    { "active": false },
    "windows": [{
      "label": "main", "title": "OpenCam",
      "width": 1100, "height": 680,
      "resizable": true, "fullscreen": false
    }]
  }
}
